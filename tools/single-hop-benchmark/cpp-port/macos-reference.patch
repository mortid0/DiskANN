+// Copyright (c) Microsoft Corporation. All rights reserved.
+// Licensed under the MIT license.
+// Darwin uint64_t and size_t are distinct 64-bit types. Preserve the Linux API semantics.
+#pragma once
+namespace diskann {
+template <typename N, typename D,
+          std::enable_if_t<!std::is_same_v<N, size_t> || !std::is_same_v<D, size_t>, int> = 0>
+inline void get_bin_metadata(const std::string &file, N &rows, D &columns, size_t offset = 0)
+{
+    size_t n, d;
+    get_bin_metadata(file, n, d, offset);
+    rows = n; columns = d;
+}
+template <typename T, typename N, typename D,
+          std::enable_if_t<!std::is_same_v<N, size_t> || !std::is_same_v<D, size_t>, int> = 0>
+inline void load_bin(const std::string &file, T *&data, N &rows, D &columns, size_t offset = 0)
+{
+    size_t n, d;
+    load_bin<T>(file, data, n, d, offset);
+    rows = n; columns = d;
+}
+template <typename T, typename N, typename D,
+          std::enable_if_t<!std::is_same_v<N, size_t> || !std::is_same_v<D, size_t>, int> = 0>
+inline void load_bin(const std::string &file, std::unique_ptr<T[]> &data, N &rows, D &columns, size_t offset = 0)
+{
+    size_t n, d;
+    load_bin<T>(file, data, n, d, offset);
+    rows = n; columns = d;
+}
+template <typename T, typename N, typename D, typename A,
+          std::enable_if_t<!std::is_same_v<N, size_t> || !std::is_same_v<D, size_t> || !std::is_same_v<A, size_t>, int> = 0>
+inline void load_aligned_bin(const std::string &file, T *&data, N &rows, D &columns, A &aligned)
+{
+    size_t n, d, a;
+    load_aligned_bin<T>(file, data, n, d, a);
+    rows = n; columns = d; aligned = a;
+}
+}
+namespace diskann {
+template <typename T, typename N, typename D,
+          std::enable_if_t<!std::is_same_v<N, size_t> || !std::is_same_v<D, size_t>, int> = 0>
+inline void copy_aligned_data_from_file(const char *file, T *&data, N &rows, D &columns,
+                                        const size_t &aligned, size_t offset = 0)
+{
+    size_t n = rows, d = columns;
+    copy_aligned_data_from_file<T>(file, data, n, d, aligned, offset);
+    rows = n; columns = d;
+}
+}
