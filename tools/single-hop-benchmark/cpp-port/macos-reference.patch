+// Copyright (c) Microsoft Corporation. All rights reserved.
+// Licensed under the MIT license.
+#include "pq.h"
+#include <omp.h>
+#include <iostream>
+
+int main(int argc, char **argv)
+{
+    if (argc != 6) {
+        std::cerr << "Usage: encode_pq_reference BASE.u8bin PIVOTS.bin CODES.bin PQ_BYTES THREADS\n";
+        return 2;
+    }
+    try {
+        const auto bytes = static_cast<uint32_t>(std::stoul(argv[4]));
+        const auto threads = static_cast<int>(std::stoul(argv[5]));
+        if (bytes == 0 || threads <= 0) throw std::invalid_argument("positive PQ bytes and threads required");
+        omp_set_num_threads(threads);
+        return diskann::generate_pq_data_from_pivots<uint8_t>(argv[1], 256, bytes, argv[2], argv[3], false);
+    } catch (const std::exception &error) {
+        std::cerr << error.what() << "\n";
+        return 1;
+    }
+}
