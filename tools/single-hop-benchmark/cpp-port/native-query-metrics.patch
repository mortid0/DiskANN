+#pragma once
+#include <cstdint>
+namespace diskann_reference {
+struct Metrics {
+    std::uint64_t full_distance_comparisons = 0;
+    std::uint64_t pq_distance_comparisons = 0;
+    std::uint64_t label_checks = 0;
+    std::uint64_t returned_results = 0;
+    std::uint64_t read_requests = 0;
+    std::uint64_t requested_read_bytes = 0;
+};
+inline thread_local Metrics metrics;
+}
